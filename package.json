    "check:preview-styles": "node scripts/check-preview-styles.mjs",
    "audit:usage": "node scripts/audit-component-usage.mjs --write-status",
    "test:usage-audit": "node --test scripts/audit-component-usage.test.mjs",
    "source:import-cdata": "node scripts/import-cdata-components.mjs",
    "test:categories": "node --test scripts/component-categories.test.mjs",
    "foundations:generate": "node scripts/proposal-foundations.mjs",
    "check:foundations": "node scripts/proposal-foundations.mjs --check && node scripts/check-proposal-foundations.mjs"
  },
